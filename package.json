{
  "name": "@giuseppe.trisciuoglio/pi-prevent-destructive-commands",
  "version": "1.0.0",
  "description": "Unconditionally blocks destructive bash commands before execution. A pi extension that guards against rm, git reset --hard, docker rm, aws delete operations, and more.",
  "keywords": [
    "pi",
    "pi-extension",
    "ai-agent",
    "safety",
    "destructive-commands",
    "bash",
    "shell",
    "guard",
    "security",
    "rm",
    "git",
    "docker",
    "aws"
  ],
  "author": "Giuseppe Trisciuoglio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/giuseppe-trisciuoglio/pi-prevent-destructive-commands.git"
  },
  "bugs": {
    "url": "https://github.com/giuseppe-trisciuoglio/pi-prevent-destructive-commands/issues"
  },
  "homepage": "https://github.com/giuseppe-trisciuoglio/pi-prevent-destructive-commands#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npm run test:smoke && npm run test:migration-guard && npm run test:nx-guard && npm run test:e2e",
    "test:smoke": "npx tsx test/smoke-test.ts",
    "test:e2e": "npx tsx test/e2e-install-test.ts",
    "test:migration-guard": "npx tsx test/migration-guard-test.ts",
    "test:nx-guard": "npx tsx test/nx-guard-test.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.1.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0"
  },
  "pi": {
    "name": "prevent-destructive-commands",
    "displayName": "Prevent Destructive Commands",
    "description": "Blocks destructive bash commands (rm, git reset, docker rm, AWS delete, etc.) before execution.",
    "category": "security",
    "extensions": [
      "./src/index.ts"
    ]
  }
}
